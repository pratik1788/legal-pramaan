// Prisma schema — PostgreSQL (default).
// For SQLite local dev, use prisma/schema.sqlite.prisma instead:
//   npm run db:sqlite
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per customer order. The wizard payload is stored as JSON so the
// document can be re-rendered any time without re-entering data.
model Order {
  id               String      @id @default(cuid())
  serviceType      String      @default("rent_agreement") // rent_agreement | affidavit | estamp
  status           OrderStatus @default(draft)
  // Customer contact
  customerName     String
  customerPhone    String
  customerEmail    String?
  // Wizard answers (parties, property, terms, add-ons, language)
  payload          Json
  // Money is stored in paise (integer) to avoid float errors.
  serviceFeePaise  Int
  stampDutyPaise   Int
  addonsPaise      Int         @default(0)
  totalPaise       Int
  currency         String      @default("INR")
  // Razorpay
  razorpayOrderId  String?
  razorpayPaymentId String?
  // Fulfilment
  stampedPdfPath   String?     // path under ./uploads served by /api/orders/[id]/document
  trackingNote     String?
  adminNote        String?
  paidAt           DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status])
  @@index([customerPhone])
}

enum OrderStatus {
  draft
  paid
  in_review
  stamped
  delivered
  cancelled
}

// Change requests posted by the (non-technical) business team via /team.
// They describe in plain language how a feature should work; the builder
// (Ziggy) picks them up and implements them.
model ChangeRequest {
  id          String              @id @default(cuid())
  title       String
  description String
  authorName  String              @default("")
  status      ChangeRequestStatus @default(NEW)
  adminNote   String              @default("")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum ChangeRequestStatus {
  NEW
  IN_PROGRESS
  DONE
  DECLINED
}
