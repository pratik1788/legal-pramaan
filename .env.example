# ------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit a real .env with secrets.
# ------------------------------------------------------------------

# Database: PostgreSQL connection string (docker-compose provides one).
# For SQLite local dev instead, use: DATABASE_URL="file:./dev.db"
# and run: npm run db:sqlite
DATABASE_URL="postgresql://legal:legal@localhost:5432/legaldb?schema=public"

# Admin dashboard password (route /admin). Pick a long random value.
ADMIN_PASSWORD=change-me-to-a-long-random-string
# Secret used to sign the admin session cookie.
ADMIN_SESSION_SECRET=change-me-to-another-long-random-string

# Razorpay (test mode). Get keys from https://dashboard.razorpay.com/app/keys
# Leave blank to enable DEV simulated checkout (development only).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Public key exposed to the browser checkout page.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Base URL of the deployed app (used for callbacks / absolute links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Pricing (paise). Service fee charged per rent-agreement order.
SERVICE_FEE_RENT_AGREEMENT_PAISA="19900"
# Optional add-ons (paise).
ADDON_ESIGN_PAISA="3900"
ADDON_NOTARY_PAISA="7000"
