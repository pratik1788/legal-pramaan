{
  "name": "legal-pramaan",
  "version": "0.1.0",
  "private": true,
  "description": "Legal Pramaan — online legal documentation platform for India (MVP): guided document builder, stamp-duty engine, checkout, admin. Launching in Gujarat.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:sqlite": "prisma generate --schema=prisma/schema.sqlite.prisma && DATABASE_URL=\"file:./dev.db\" prisma db push --schema=prisma/schema.sqlite.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^3.4.4",
    "next": "14.2.18",
    "razorpay": "^2.9.6",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
